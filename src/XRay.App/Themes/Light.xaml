    <SolidColorBrush x:Key="Accent.Text" Color="#FF087A97" />
    <SolidColorBrush x:Key="Chart.Fill" Color="#220A8FB0" />
    <SolidColorBrush x:Key="Chart.Grid" Color="#FFE6E8EC" />
    <SolidColorBrush x:Key="Chart.Secondary" Color="#FF7B52D6" />
    <SolidColorBrush x:Key="Chart.SecondaryFill" Color="#187B52D6" />

    <SolidColorBrush x:Key="Status.Good" Color="#FF1F8A5B" />
    <SolidColorBrush x:Key="Status.Warn" Color="#FFB97A0E" />
    <SolidColorBrush x:Key="Status.Bad" Color="#FFC93A32" />
    <SolidColorBrush x:Key="Status.GoodSubtle" Color="#1F1F8A5B" />
    <SolidColorBrush x:Key="Status.WarnSubtle" Color="#1FB97A0E" />
