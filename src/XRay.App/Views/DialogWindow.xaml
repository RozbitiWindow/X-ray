<Window x:Class="XRay.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X-RAY" Width="480" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Bg.Surface}" FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="IconText" Style="{StaticResource Icon.Plain}" FontSize="18" Margin="0,0,10,0" />
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource Text.Muted}"
                   TextWrapping="Wrap" LineHeight="19" />
        <Border x:Name="DetailBorder" Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource Callout}" Visibility="Collapsed">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="DetailText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                         FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="90" Click="OnCancel" />
            <Button x:Name="OkButton" Content="OK" Style="{StaticResource Button.Primary}" MinWidth="90" Margin="8,0,0,0"
                    IsDefault="True" Click="OnOk" />
        </StackPanel>
    </Grid>
</Window>
