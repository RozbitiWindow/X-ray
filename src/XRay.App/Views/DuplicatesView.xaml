<UserControl x:Class="XRay.App.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:XRay.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DuplicatesViewModel}">
    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Duplicates" Style="{StaticResource Text.Title}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                       Text="Find files with byte-identical content. Selected copies go to the Recycle Bin only after you confirm, and at least one copy of every file is always kept." />
        </StackPanel>

        <!-- Search form -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5"
                         AutomationProperties.Name="Folder to search for duplicates" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding FindCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="Min. size (MB)" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding MinSizeMb, UpdateSourceTrigger=PropertyChanged}" Width="70" AutomationProperties.Name="Minimum duplicate size in megabytes"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Browse…" Command="{Binding BrowseCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Command="{Binding FindCommand}" AutomationProperties.Name="Find duplicates"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisInverted}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Find duplicates" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Style="{StaticResource Button.Danger}" Content="Cancel" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource Button.Icon}" Content="&#xE72C;" Margin="4,0,0,0" Command="{Binding RescanCommand}"
                            ToolTip="Re-read the folder structure and compare again" AutomationProperties.Name="Rescan" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary -->
        <StackPanel Grid.Row="2" Margin="2,0,0,10">
            <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource Status.Bad}" Style="{StaticResource Text.Caption}"
                       Visibility="{Binding ValidationMessage, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" TextWrapping="Wrap"
                       Visibility="{Binding ShowResults, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding SourceNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding SourceNote, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding SkippedNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding SkippedNote, Converter={StaticResource NotEmptyToVis}}" />
        </StackPanel>

        <!-- Progress -->
        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="24,22"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding PhaseText}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,16" />
                <ContentControl Content="{Binding TreeProgress}" Focusable="False"
                                Visibility="{Binding IsScanningTree, Converter={StaticResource BoolToVis}}" />
                <StackPanel Visibility="{Binding IsScanningTree, Converter={StaticResource BoolToVisInverted}}">
                    <ProgressBar IsIndeterminate="{Binding PhaseIndeterminate}" Value="{Binding PhasePercent, Mode=OneWay}" Maximum="100" />
                    <TextBlock Text="{Binding PhaseDetail}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Tertiary}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Only files whose sizes match are read. Contents are compared with SHA-256; files are opened read-only." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Empty state -->
        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="28"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Accent.Subtle}" VerticalAlignment="Top">
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon.Plain}" FontSize="24" Foreground="{DynamicResource Accent.Text}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Margin="18,0,0,0" MaxWidth="660">
                    <TextBlock Text="Choose a folder and press Find duplicates" Style="{StaticResource Text.Subtitle}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                               Text="Good places to start are Downloads, Pictures or a backup drive. Files in Windows and Program Files are shown but never offered for removal, and cloud-only files are not downloaded." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="3" Visibility="{Binding ShowResults, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,10" Visibility="{Binding HasGroups, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Select all copies except the" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="2,0,8,0" />
                <Button Content="Newest" Command="{Binding KeepNewestCommand}" Margin="0,0,6,0" ToolTip="Keep the most recently modified copy in each group" />
                <Button Content="Oldest" Command="{Binding KeepOldestCommand}" Margin="0,0,6,0" ToolTip="Keep the oldest copy in each group" />
                <Button Content="Shortest path" Command="{Binding KeepShortestPathCommand}" Margin="0,0,6,0" ToolTip="Keep the copy with the shortest path in each group" />
                <Button Content="Clear selection" Style="{StaticResource Button.Ghost}" Command="{Binding ClearSelectionCommand}" />
            </WrapPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Groups}" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Duplicate groups">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DuplicateGroupRow}">
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,8,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="4" Height="30" CornerRadius="2" Background="{Binding Swatch}" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{DynamicResource Accent.Subtle}">
                                        <TextBlock Text="{Binding WastedText}" FontSize="12" Foreground="{DynamicResource Accent.Text}" />
                                    </Border>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DuplicateFileRow}">
                                            <Border x:Name="Row" CornerRadius="5" Padding="8,5" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                                              VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding FullPath}" ToolTip="Select this copy for the Recycle Bin" />
                                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" ToolTip="{Binding FullPath}">
                                                        <TextBlock Text="{Binding Folder}" Style="{StaticResource Text.Mono}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}" FontSize="11" />
                                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" FontSize="11" Margin="10,0,0,0"
                                                                       Foreground="{DynamicResource Status.Warn}"
                                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                        <Button Style="{StaticResource Button.Icon}" Width="28" Height="28" FontSize="13" Content="&#xE838;"
                                                                ToolTip="Show in Explorer" AutomationProperties.Name="Show in Explorer"
                                                                Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource Button.Icon}" Width="28" Height="28" FontSize="13" Content="&#xE8C8;"
                                                                ToolTip="Copy path" AutomationProperties.Name="Copy path"
                                                                Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Status.BadSubtle}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Action bar -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10"
                Visibility="{Binding HasGroups, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedText}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Button.Danger}" Command="{Binding RecycleSelectedCommand}" AutomationProperties.Name="Move selected to Recycle Bin">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Move selected to Recycle Bin…" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Margin="2,12,0,0"
                   Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisInverted}}" />
    </Grid>
</UserControl>
