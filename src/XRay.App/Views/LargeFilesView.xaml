<UserControl x:Class="XRay.App.Views.LargeFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:XRay.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:LargeFilesViewModel}">
    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Large Files" Style="{StaticResource Text.Title}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                       Text="Find big files worth reviewing. Categories are hints based on name, type and location - they never mean a file is safe to delete. X-RAY does not delete anything." />
        </StackPanel>

        <!-- Search form -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5"
                             AutomationProperties.Name="Folder to search" IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBool}}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="Browse…" Command="{Binding BrowseCommand}" IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBool}}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Command="{Binding SearchCommand}"
                                Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisInverted}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Search" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Style="{StaticResource Button.Danger}" Content="Cancel" Command="{Binding CancelCommand}"
                                Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE72C;" Margin="4,0,0,0" Command="{Binding RescanCommand}"
                                ToolTip="Rescan the folder for fresh data" AutomationProperties.Name="Rescan" />
                    </StackPanel>
                </Grid>
                <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="MINIMUM SIZE (MB)" Style="{StaticResource Text.Section}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding MinSizeMb, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="110" AutomationProperties.Name="Minimum size in megabytes">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApplyFiltersCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="EXTENSIONS" Style="{StaticResource Text.Section}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}" Width="200" AutomationProperties.Name="Extensions"
                                 ToolTip="Comma separated, e.g. iso, zip, mp4. Leave empty for all types.">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApplyFiltersCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="AGE" Style="{StaticResource Text.Section}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding AgeOptions}" SelectedItem="{Binding SelectedAge}" DisplayMemberPath="Label" Width="170" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="REVIEW CATEGORY" Style="{StaticResource Text.Section}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label" Width="190" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="SORT" Style="{StaticResource Text.Section}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Label" Width="150" />
                    </StackPanel>
                    <Button Content="Apply filters" VerticalAlignment="Bottom" Command="{Binding ApplyFiltersCommand}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Scope / status -->
        <StackPanel Grid.Row="2" Margin="2,0,0,10">
            <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource Status.Bad}" Style="{StaticResource Text.Caption}"
                       Visibility="{Binding ValidationMessage, Converter={StaticResource NotEmptyToVis}}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding ScopeText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                       Visibility="{Binding ScopeText, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0" Visibility="{Binding SourceNote, Converter={StaticResource NotEmptyToVis}}">
                <Run Text="{Binding ResultSummary, Mode=OneWay}" Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" />
                <Run Text="  ·  " />
                <Run Text="{Binding SourceNote, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!-- Progress -->
        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="24,22"
                Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Reading folder structure…" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,16" />
                <ContentControl Content="{Binding Progress}" Focusable="False" />
            </StackPanel>
        </Border>

        <!-- Empty state -->
        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="28"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Accent.Subtle}" VerticalAlignment="Top">
                    <TextBlock Text="&#xE8B9;" Style="{StaticResource Icon.Plain}" FontSize="24" Foreground="{DynamicResource Accent.Text}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Margin="18,0,0,0" MaxWidth="620">
                    <TextBlock Text="Choose a folder and press Search" Style="{StaticResource Text.Subtitle}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                               Text="The folder and all of its sub-folders are searched once; changing filters afterwards is instant. If the Disk Analyzer has already scanned the folder, its results are reused." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10,12,6,6"
                Visibility="{Binding ShowResults, Converter={StaticResource BoolToVis}}">
            <Grid>
                <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                          MouseDoubleClick="OnResultDoubleClick" AutomationProperties.Name="Large files">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Show in Explorer" Command="{Binding RevealCommand}" CommandParameter="{Binding SelectedResult}">
                                <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon.Plain}" FontSize="13" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedResult}">
                                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon.Plain}" FontSize="13" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="FILE" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5" ToolTip="{Binding FullPath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="4" Height="28" CornerRadius="2" Background="{Binding Swatch}" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Text.Caption}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="SIZE" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" Style="{StaticResource Text.Base}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="MODIFIED" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Text.Base}" FontSize="12" />
                                        <TextBlock Text="{Binding AgeText}" Style="{StaticResource Text.Caption}" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="REVIEW HINT" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{Binding Reason}">
                                        <Border Style="{StaticResource Badge}" Background="{DynamicResource Status.WarnSubtle}">
                                            <TextBlock Text="{Binding CategoryText}" FontSize="11.5" Foreground="{DynamicResource Status.Warn}" />
                                        </Border>
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Caption}" FontSize="11" Margin="8,0,0,0" Width="150"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Icon}" Width="28" Height="28" FontSize="13" Content="&#xE838;"
                                            ToolTip="Show in Explorer" AutomationProperties.Name="Show in Explorer"
                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No files match these filters. Try a smaller minimum size or a different category." Style="{StaticResource Text.Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" IsHitTestVisible="False"
                           Visibility="{Binding HasResults, Converter={StaticResource BoolToVisInverted}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
