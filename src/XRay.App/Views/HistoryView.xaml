<UserControl x:Class="XRay.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:XRay.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:HistoryViewModel}">
    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Storage History" Style="{StaticResource Text.Title}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                       Text="Save snapshots of folder sizes and compare them later to see what grew. Snapshots are only taken when you ask - never in the background." />
        </StackPanel>

        <!-- Create snapshot -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SnapshotPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5"
                             AutomationProperties.Name="Folder to snapshot" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="Browse…" Command="{Binding BrowseCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Command="{Binding CreateSnapshotCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisInverted}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Take snapshot" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Style="{StaticResource Button.Danger}" Content="Cancel" Command="{Binding CancelCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding ScopeHint}" Style="{StaticResource Text.Caption}" Margin="2,8,0,0" TextWrapping="Wrap" />
                <ContentControl Content="{Binding Progress}" Margin="0,16,0,0" Focusable="False"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Accent.Text}" Margin="2,8,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVis}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Snapshot list -->
            <Border Style="{StaticResource Card}" Padding="12,14,6,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,6,8">
                        <TextBlock Text="Saved snapshots" Style="{StaticResource Text.Subtitle}" />
                        <Button Style="{StaticResource Button.Link}" Content="Open folder" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding OpenSnapshotFolderCommand}" FontSize="12" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" AutomationProperties.Name="Saved snapshots">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding CreatedText}" FontWeight="SemiBold" Style="{StaticResource Text.Base}" />
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Base}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                    <TextBlock Text="{Binding RootPath}" Style="{StaticResource Text.Mono}" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="No snapshots yet. Take one above, or use the save button in the Disk Analyzer."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="6,20,6,0"
                               Visibility="{Binding HasSnapshots, Converter={StaticResource BoolToVisInverted}}" />
                    <Button Grid.Row="2" Style="{StaticResource Button.Danger}" HorizontalAlignment="Left" Margin="4,8,0,0"
                            Command="{Binding DeleteSnapshotCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Delete selected…" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Comparison -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,14,6,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,8,10">
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="BASELINE" Style="{StaticResource Text.Section}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Baseline}" DisplayMemberPath="Display" Width="300" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="COMPARE WITH" Style="{StaticResource Text.Section}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Target}" DisplayMemberPath="Display" Width="300" />
                        </StackPanel>
                        <Button Style="{StaticResource Button.Primary}" Content="Compare" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                Command="{Binding CompareCommand}" />
                    </WrapPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,8,8" Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ComparisonTitle}" Style="{StaticResource Text.Subtitle}" />
                        <TextBlock Text="{Binding ComparisonSummary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Border Style="{StaticResource Callout}" Margin="0,8,0,0" Background="{DynamicResource Status.WarnSubtle}" BorderThickness="0"
                                Visibility="{Binding ComparisonWarnings, Converter={StaticResource NotEmptyToVis}}">
                            <TextBlock Text="{Binding ComparisonWarnings}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,8,8" Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Show" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label" Width="170" />
                            <TextBlock Text="Depth up to" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="14,0,8,0" />
                            <ComboBox ItemsSource="{Binding DepthOptions}" SelectedItem="{Binding MaxDepth}" Width="70" MinWidth="70" />
                        </StackPanel>
                        <TextBlock Text="{Binding DiffCountText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Diff}" AutomationProperties.Name="Changes"
                              Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="FOLDER" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4" ToolTip="{Binding Note}">
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Base}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" FontSize="11"
                                                       Visibility="{Binding Note, Converter={StaticResource NotEmptyToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="CHANGE" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" x:Name="Badge">
                                            <TextBlock x:Name="Label" Text="{Binding KindText}" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Grown">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Status.BadSubtle}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Status.Bad}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Status.BadSubtle}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Status.Bad}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Shrunk">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Status.GoodSubtle}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Status.Good}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Status.GoodSubtle}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Status.Good}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="NotComparable">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Status.WarnSubtle}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Status.Warn}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="BEFORE" Binding="{Binding OldText}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="AFTER" Binding="{Binding NewText}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="DIFFERENCE" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DeltaText}" ToolTip="{Binding DeltaExact}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" Style="{StaticResource Text.Base}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,8,0" VerticalAlignment="Top"
                               Text="Pick two snapshots and press Compare. Changes are only reported as measured when both scans could read the folder completely; anything else is marked as not comparable."
                               Visibility="{Binding HasComparison, Converter={StaticResource BoolToVisInverted}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
