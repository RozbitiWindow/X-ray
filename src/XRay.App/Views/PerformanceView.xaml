<UserControl x:Class="XRay.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:XRay.App.Controls"
             xmlns:vm="clr-namespace:XRay.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PerformanceViewModel}">
    <UserControl.Resources>
        <Style x:Key="ChartCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="6" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Pad.Page}">
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Performance" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="Live system metrics for this session. Nothing is recorded to disk." Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding HistorySpan}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>

            <UniformGrid Columns="2" Margin="-6,0">
                <!-- CPU -->
                <Border Style="{StaticResource ChartCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU utilization" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CpuText}" Style="{StaticResource Text.Metric}" FontSize="22" HorizontalAlignment="Right" />
                        </Grid>
                        <controls:SparklineChart Height="130" Margin="0,10,0,0" Values="{Binding Metrics.CpuHistory}" Revision="{Binding Revision}"
                                                 Maximum="100" Capacity="{Binding HistoryCapacity}" Stroke="{DynamicResource Accent}"
                                                 Fill="{DynamicResource Chart.Fill}" GridBrush="{DynamicResource Chart.Grid}" />
                        <TextBlock Text="0–100% of all logical processors" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Foreground="{DynamicResource Text.Tertiary}" />
                    </StackPanel>
                </Border>
                <!-- Memory -->
                <Border Style="{StaticResource ChartCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Memory in use" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Text.Metric}" FontSize="22" HorizontalAlignment="Right" />
                        </Grid>
                        <controls:SparklineChart Height="130" Margin="0,10,0,0" Values="{Binding Metrics.MemoryHistory}" Revision="{Binding Revision}"
                                                 Maximum="100" Capacity="{Binding HistoryCapacity}" Stroke="{DynamicResource Chart.Secondary}"
                                                 Fill="{DynamicResource Chart.SecondaryFill}" GridBrush="{DynamicResource Chart.Grid}" />
                        <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <!-- GPU -->
                <Border Style="{StaticResource ChartCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="GPU utilization" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GpuText}" Style="{StaticResource Text.Metric}" FontSize="22" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Height="130" Margin="0,10,0,0">
                            <controls:SparklineChart Values="{Binding Metrics.GpuHistory}" Revision="{Binding Revision}"
                                                     Maximum="100" Capacity="{Binding HistoryCapacity}" Stroke="{DynamicResource Status.Good}"
                                                     Fill="{DynamicResource Status.GoodSubtle}" GridBrush="{DynamicResource Chart.Grid}" />
                            <TextBlock Text="{Binding GpuUnavailable}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                                       Visibility="{Binding GpuUnavailable, Converter={StaticResource NotEmptyToVis}}" />
                        </Grid>
                        <TextBlock Text="{Binding GpuDetail}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <!-- Disk -->
                <Border Style="{StaticResource ChartCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Disk activity" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DiskText}" Style="{StaticResource Text.Metric}" FontSize="22" HorizontalAlignment="Right" ToolTip="Share of time the disks were busy" />
                        </Grid>
                        <Grid Height="130" Margin="0,10,0,0">
                            <controls:SparklineChart Values="{Binding Metrics.DiskReadHistory}" SecondaryValues="{Binding Metrics.DiskWriteHistory}"
                                                     Revision="{Binding Revision}" AutoScale="True" Capacity="{Binding HistoryCapacity}"
                                                     Stroke="{DynamicResource Accent}" Fill="{DynamicResource Chart.Fill}"
                                                     SecondaryStroke="{DynamicResource Status.Warn}" SecondaryFill="{DynamicResource Status.WarnSubtle}"
                                                     GridBrush="{DynamicResource Chart.Grid}" />
                            <TextBlock Text="{Binding DiskUnavailable}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                                       Visibility="{Binding DiskUnavailable, Converter={StaticResource NotEmptyToVis}}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,5,0" />
                            <TextBlock Text="Read" Style="{StaticResource Text.Caption}" Margin="0,0,12,0" />
                            <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource Status.Warn}" Margin="0,0,5,0" />
                            <TextBlock Text="Write" Style="{StaticResource Text.Caption}" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding DiskDetail}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Processes -->
                <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="14,14,8,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="460" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,6,6">
                            <TextBlock Text="Processes" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="By CPU" GroupName="ProcSort" IsChecked="{Binding SortProcessesByCpu}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="By memory" GroupName="ProcSort" IsChecked="{Binding SortProcessesByMemory}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding ProcessNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,6,8" />
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Processes}" AutomationProperties.Name="Processes">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}" />
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="CPU" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CpuText}" ToolTip="{Binding CpuTooltip}" HorizontalAlignment="Right" Style="{StaticResource Text.Base}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="WORKING SET" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MemoryText}" HorizontalAlignment="Right" Style="{StaticResource Text.Base}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="PRIVATE" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PrivateText}" HorizontalAlignment="Right" Style="{StaticResource Text.Caption}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <!-- GPU details -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Graphics adapters" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding GpuUnavailable}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                       Visibility="{Binding GpuUnavailable, Converter={StaticResource NotEmptyToVis}}" />
                            <ItemsControl ItemsSource="{Binding Gpus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource Text.Base}" TextTrimming="CharacterEllipsis" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Utilization" Style="{StaticResource Text.Caption}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Utilization}" Style="{StaticResource Text.Base}" />
                                                <TextBlock Grid.Row="1" Text="Temperature" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Temperature}" Style="{StaticResource Text.Base}" Margin="0,3,0,0"
                                                           ToolTip="{Binding TemperatureNote}" />
                                                <TextBlock Grid.Row="2" Text="Dedicated memory" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Memory}" Style="{StaticResource Text.Base}" Margin="0,3,0,0"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                            <TextBlock Text="{Binding TemperatureNote}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Tertiary}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding TemperatureNote, Converter={StaticResource NotEmptyToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap"
                                       Text="Read through Windows (DXGI and GPU performance counters) - no vendor tools required. Temperature appears only when the driver reports it." />
                        </StackPanel>
                    </Border>
                    <!-- Drives -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Available disk capacity" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Base}" TextTrimming="CharacterEllipsis" Margin="0,0,90,0" />
                                                <TextBlock Text="{Binding FreeText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ContentControl Style="{StaticResource UsageBar}" Tag="{Binding UsedPercent}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
