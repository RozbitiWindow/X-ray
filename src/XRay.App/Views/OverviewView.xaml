<UserControl x:Class="XRay.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:XRay.App.Controls"
             xmlns:vm="clr-namespace:XRay.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:OverviewViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Pad.Page}">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Overview" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenPerformanceCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Open Performance" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Command="{Binding ScanFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Scan a folder…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Live tiles -->
            <UniformGrid Columns="3" Margin="-6,0,-6,0">
                <!-- CPU -->
                <Border Style="{StaticResource Card}" Margin="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="58" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE950;" Style="{StaticResource Icon.Plain}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="CPU" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,8,0,8">
                            <TextBlock Text="{Binding CpuText}" Style="{StaticResource Text.Metric}" />
                            <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <controls:SparklineChart Grid.Row="2" Values="{Binding Metrics.CpuHistory}" Revision="{Binding Revision}" Maximum="100"
                                                 Capacity="90" Stroke="{DynamicResource Accent}" Fill="{DynamicResource Chart.Fill}" />
                    </Grid>
                </Border>
                <!-- Memory -->
                <Border Style="{StaticResource Card}" Margin="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="58" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE964;" Style="{StaticResource Icon.Plain}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Memory" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,8,0,8">
                            <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Text.Metric}" />
                            <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <controls:SparklineChart Grid.Row="2" Values="{Binding Metrics.MemoryHistory}" Revision="{Binding Revision}" Maximum="100"
                                                 Capacity="90" Stroke="{DynamicResource Chart.Secondary}" Fill="{DynamicResource Chart.SecondaryFill}" />
                    </Grid>
                </Border>
                <!-- GPU -->
                <Border Style="{StaticResource Card}" Margin="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="58" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon.Plain}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="GPU" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,8,0,8">
                            <TextBlock Text="{Binding GpuText}" Style="{StaticResource Text.Metric}" />
                            <TextBlock Text="{Binding GpuDetail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GpuDetail}" />
                        </StackPanel>
                        <controls:SparklineChart Grid.Row="2" Values="{Binding Metrics.GpuHistory}" Revision="{Binding Revision}" Maximum="100"
                                                 Capacity="90" Stroke="{DynamicResource Status.Good}" Fill="{DynamicResource Status.GoodSubtle}"
                                                 Visibility="{Binding GpuAvailable, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Row="2" Text="{Binding GpuNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource Text.Tertiary}" Background="{DynamicResource Bg.Surface}"
                                   Visibility="{Binding GpuNote, Converter={StaticResource NotEmptyToVis}}" />
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Drives -->
            <Grid Margin="0,24,0,10">
                <TextBlock Text="DRIVES" Style="{StaticResource Text.Section}" Margin="0" VerticalAlignment="Center" />
                <TextBlock Text="Fixed and removable drives · free space as available to you" Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Right" Foreground="{DynamicResource Text.Tertiary}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Drives}" Margin="-6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon.Plain}" FontSize="16" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Content="Analyze" VerticalAlignment="Top"
                                        Command="{Binding DataContext.AnalyzeDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Scan this whole drive in the Disk Analyzer" />
                                <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource UsageBar}" Tag="{Binding UsedPercent}" Margin="0,14,0,8" />
                                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                    <TextBlock>
                                        <Run Text="{Binding FreeText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                                        <Run Text="{Binding TotalText, Mode=OneWay}" Foreground="{DynamicResource Text.Secondary}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding UsedText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Scan + snapshot -->
            <UniformGrid Columns="2" Margin="-6,18,-6,0">
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="MOST RECENT SCAN" Style="{StaticResource Text.Section}" />
                            <Button Style="{StaticResource Button.Link}" Content="Open Disk Analyzer" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding OpenAnalyzerCommand}" />
                        </Grid>
                        <StackPanel Visibility="{Binding HasLastScan, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LastScanSize}" Style="{StaticResource Text.Metric}" FontSize="22" />
                            <TextBlock Text="{Binding LastScanPath}" Style="{StaticResource Text.Mono}" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LastScanDetail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="No folder has been scanned yet. X-RAY never scans in the background - choose a folder to start."
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                   Visibility="{Binding HasLastScan, Converter={StaticResource BoolToVisInverted}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="LAST STORAGE SNAPSHOT" Style="{StaticResource Text.Section}" />
                            <Button Style="{StaticResource Button.Link}" Content="Open History" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding OpenHistoryCommand}" />
                        </Grid>
                        <StackPanel Visibility="{Binding HasLastSnapshot, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LastSnapshotSize}" Style="{StaticResource Text.Metric}" FontSize="22" />
                            <TextBlock Text="{Binding LastSnapshotPath}" Style="{StaticResource Text.Mono}" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LastSnapshotDetail}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                        <TextBlock Text="No snapshots yet. Save one from the Disk Analyzer or the History page to track growth over time."
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                   Visibility="{Binding HasLastSnapshot, Converter={StaticResource BoolToVisInverted}}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Quick actions -->
            <TextBlock Text="QUICK ACTIONS" Style="{StaticResource Text.Section}" Margin="0,24,0,10" />
            <WrapPanel>
                <Button Margin="0,0,8,8" Command="{Binding ScanFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Scan a folder" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Command="{Binding OpenLargeFilesCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Find large files" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Command="{Binding OpenPerformanceCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Live performance" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Command="{Binding OpenHistoryCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Compare snapshots" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
